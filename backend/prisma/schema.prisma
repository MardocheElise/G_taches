generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RoleProjet {
  MEMBRE
  CHEF_PROJET
}

enum RoleUtilisateur {
  USER
  SUPER_ADMIN
}

enum StatutMembre {
  ACTIF
  INACTIF
  REFUSE
  QUITTE
  EN_ATTENTE
}

enum StatutProjet {
  PLANIFIE
  EN_COURS
  TERMINE
  ARCHIVE
}

enum PrioriteTache {
  BASSE
  NORMALE
  HAUTE
  URGENTE
}

enum StatutTache {
  A_FAIRE
  EN_COURS
  BLOQUEE
  TERMINEE
}

model User {
  id         Int    @id @default(autoincrement())
  nom        String
  prenom     String
  email      String @unique
  motDePasse String

  role RoleUtilisateur @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competences UserCompetence[]

  membresProjets MembreProjet[]

  tachesCreees Tache[] @relation("TachesCreees")

  tachesAssignees Tache[] @relation("TachesAssignees")

  projetsCrees Projet[] @relation("ProjetsCrees")
}

model UserCompetence {
  id           Int @id @default(autoincrement())
  userId       Int
  competenceId Int

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  competence Competence @relation(fields: [competenceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, competenceId])
}

model Projet {
  id          Int     @id @default(autoincrement())
  nom         String
  description String?

  dateDebut DateTime
  dateFin   DateTime?

  nombreMembresMax Int

  statut StatutProjet @default(PLANIFIE)

  createdById Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User @relation("ProjetsCrees", fields: [createdById], references: [id])

  membres     MembreProjet[]
  competences ProjetCompetence[]
  taches      Tache[]
}

model Competence {
  id        Int      @id @default(autoincrement())
  nom       String   @unique
  createdAt DateTime @default(now())

  utilisateurs  UserCompetence[]
  projets       ProjetCompetence[]
  membreProjets MembreProjet[]
}

model MembreProjet {
  id Int @id @default(autoincrement())

  userId       Int
  projetId     Int
  competenceId Int?

  role   RoleProjet   @default(MEMBRE)
  statut StatutMembre @default(EN_ATTENTE)

  dateIntegration DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projet     Projet      @relation(fields: [projetId], references: [id], onDelete: Cascade)
  competence Competence? @relation(fields: [competenceId], references: [id], onDelete: SetNull)

  @@unique([userId, projetId])
}

model ProjetCompetence {
  id Int @id @default(autoincrement())

  projetId     Int
  competenceId Int

  nombreMax Int

  projet     Projet     @relation(fields: [projetId], references: [id], onDelete: Cascade)
  competence Competence @relation(fields: [competenceId], references: [id], onDelete: Cascade)

  @@unique([projetId, competenceId])
}

model Tache {
  id          Int     @id @default(autoincrement())
  titre       String
  description String?

  priorite PrioriteTache @default(NORMALE)
  statut   StatutTache   @default(A_FAIRE)

  dateDebut    DateTime?
  dateEcheance DateTime?

  projetId    Int
  createdById Int
  assigneeId  Int?

  // Projet
  projet Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)

  // Créateur
  createdBy User @relation("TachesCreees", fields: [createdById], references: [id])

  // Responsable
  assignee User? @relation("TachesAssignees", fields: [assigneeId], references: [id])

  // Sous-tâches
  parentId Int?

  parent     Tache?  @relation("SousTaches", fields: [parentId], references: [id], onDelete: Cascade)
  sousTaches Tache[] @relation("SousTaches")

  // Dépendances
  dependances TacheDependance[] @relation("TachePrincipale")
  dependantes TacheDependance[] @relation("TacheDependante")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projetId])
  @@index([createdById])
  @@index([assigneeId])
  @@index([parentId])
}

model TacheDependance {
  id           Int      @id @default(autoincrement())
  tacheId      Int
  dependanceId Int
  tache        Tache    @relation("TachePrincipale", fields: [tacheId], references: [id], onDelete: Cascade)
  dependance   Tache    @relation("TacheDependante", fields: [dependanceId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([tacheId, dependanceId])
  @@index([tacheId])
  @@index([dependanceId])
}

